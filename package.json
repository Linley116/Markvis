{
  "name": "markvis",
  "version": "0.14.7",
  "private": true,
  "description": "Native Cocoa + WKWebView Markdown editor for macOS",
  "scripts": {
    "test": "npm run test:engine && npm run test:features && npm run test:native",
    "test:engine": "node test/engine.test.js",
    "test:features": "node test/features.test.js",
    "test:native": "./test/native.sh",
    "test:pdf": "./test/pdf-regression.sh",
    "test:browser:install": "playwright-core install chromium",
    "changelog": "node scripts/gen-changelog.js",
    "changelog:check": "node scripts/gen-changelog.js --check",
    "release:publish": "node scripts/publish-release.js"
  },
  "devDependencies": {
    "playwright-core": "1.58.2"
  }
}
